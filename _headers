# Cloudflare Pages: header cho từng nhóm file.
# Mặc định Pages trả "max-age=0, must-revalidate" cho MỌI file,
# nên khách quay lại lần 2 vẫn phải hỏi lại server cho từng ảnh (304).
# Khai báo dưới đây để trình duyệt giữ ảnh/nhạc trong cache, không hỏi lại.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  X-Frame-Options: SAMEORIGIN

# Ảnh: 7 ngày. Đổi nội dung ảnh mà giữ nguyên tên thì khách cũ vẫn thấy bản cũ tối đa 7 ngày.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Nhạc nền + audio: gần như không bao giờ đổi nội dung -> cache 1 năm
/music/*
  Cache-Control: public, max-age=31536000, immutable

/audio/*
  Cache-Control: public, max-age=31536000, immutable

# Trang làm mới: máy kẹt ở bản cũ mở /reset một lần -> trình duyệt xoá cache HTTP của trang
# (service worker và CacheStorage do script trong reset.html xoá; localStorage giữ nguyên)
/reset
  Clear-Site-Data: "cache"
  Cache-Control: no-store
/reset.html
  Clear-Site-Data: "cache"
  Cache-Control: no-store

# CSS/JS của trang (tách từ index.html): trình duyệt giữ file, mỗi lần mở chỉ hỏi lại máy chủ.
# File không đổi thì nhận 304 (vài trăm byte) thay vì tải lại cả trăm KB; đổi file thì bản mới lên ngay.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

# HTML: luôn kiểm tra lại để bản mới lên ngay
/*.html
  Cache-Control: public, max-age=0, must-revalidate
